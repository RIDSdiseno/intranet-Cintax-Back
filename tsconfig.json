{
"compilerOptions": {
"target": "ES2022",
"module": "node16",

"lib": ["ES2022"],

"rootDir": "src",
"outDir": "./dist",

"strict": true,
"esModuleInterop": true,
"skipLibCheck": true,
"forceConsistentCasingInFileNames": true,

"moduleResolution": "node16",
"resolveJsonModule": true,

"sourceMap": true

},
"include": [
"src/**/*.ts"
],
"exclude": [
"node_modules",
"dist",
"prisma",
"src/scripts/**"
]
}
